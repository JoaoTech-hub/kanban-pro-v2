# URLs PostgreSQL da aplicação; para npm test, use uma branch/banco dedicado.
# Configure URLs próprias em backend/.env.test; nunca use o banco de desenvolvimento.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST_NEON_POOLER/NOME_DO_BANCO?sslmode=require
DIRECT_URL=postgresql://USUARIO:SENHA@HOST_NEON_DIRECT/NOME_DO_BANCO?sslmode=require

# Gere um segredo aleatório com pelo menos 32 bytes; não use o placeholder abaixo diretamente.
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_BYTES
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
GOOGLE_CLIENT_ID=
# Obrigatórios em backend/.env.test antes de permitir a limpeza do banco.
# O marcador deve ser o identificador exato da branch Neon dedicada a testes,
# igual ao rótulo do host (sem o sufixo -pooler quando DATABASE_URL o usar).
CONFIRM_TEST_DB_RESET=
TEST_DATABASE_MARKER=
